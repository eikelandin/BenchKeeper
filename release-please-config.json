{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "group-pull-request-title-pattern": "chore${scope}: release cedarloom",
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "cedarloom plugins",
      "components": ["cedarloom", "cedarloom-workflow", "cedarloom-repo", "cedarloom-orchestration"],
      "merge": false
    }
  ],
  "packages": {
    "plugins/cedarloom": {
      "release-type": "simple",
      "component": "cedarloom",
      "include-component-in-tag": true,
      "release-as": "0.1.0",
      "extra-files": [{ "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" }]
    },
    "plugins/cl-workflow": {
      "release-type": "simple",
      "component": "cedarloom-workflow",
      "include-component-in-tag": true,
      "release-as": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    },
    "plugins/cl-repo": {
      "release-type": "simple",
      "component": "cedarloom-repo",
      "include-component-in-tag": true,
      "release-as": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    },
    "plugins/cl-orchestration": {
      "release-type": "simple",
      "component": "cedarloom-orchestration",
      "include-component-in-tag": true,
      "release-as": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
