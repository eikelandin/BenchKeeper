{
  "schemaVersion": 1,
  "kind": "cedarloom.profile",
  "id": "cedarloom.core",
  "version": "0.1.0",
  "name": "Core",
  "description": "Claude Code with the CedarLoom plugin, CedarLoom's global rules and Claude Code settings; in each project the AGENTS.md rules, the deny rules and the default tier.",
  "license": "ISC",
  "minApp": "0.1.0",
  "agents": ["claude-code"],
  "packs": {
    "cedarloom.core": {
      "bundled": true
    }
  },
  "machine": {
    "plugin.cedarloom": {
      "type": "plugin",
      "title": "CedarLoom workflow plugin",
      "default": "on",
      "plugin": "cedarloom@cedarloom",
      "marketplace": {
        "name": "cedarloom",
        "git": "https://github.com/cedarloom/cedarloom.git",
        "ref": "stable"
      }
    },
    "rules.global": {
      "type": "rules",
      "title": "Global rules",
      "default": "on",
      "file": "00-global.md",
      "text": {
        "pack": "cedarloom.core",
        "path": "rules/global.md"
      }
    },
    "settings.claude-code": {
      "type": "settings",
      "title": "Claude Code settings",
      "default": "on",
      "set": {
        "autoUpdatesChannel": "stable",
        "showClearContextOnPlanAccept": true,
        "attribution": {
          "commit": "",
          "pr": "",
          "sessionUrl": false
        },
        "feedbackDrafts": "off",
        "env": {
          "DISABLE_ERROR_REPORTING": "1",
          "DISABLE_FEEDBACK_COMMAND": "1",
          "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
        }
      }
    }
  },
  "project": {
    "manual": {
      "type": "manual",
      "title": "AGENTS.md rules and CLAUDE.md import",
      "default": "on",
      "claudeImport": true,
      "rules": [
        {
          "pack": "cedarloom.core",
          "path": "rules/project.md"
        },
        {
          "pack": "cedarloom.core",
          "path": "rules/family.md"
        },
        {
          "pack": "cedarloom.core",
          "path": "rules/tests.md"
        }
      ]
    },
    "guards": {
      "type": "settings",
      "title": "Deny rules: no --no-verify, no force push, no sudo, no infrastructure apply",
      "default": "on",
      "commit": true,
      "set": {
        "permissions": {
          "deny": [
            "Bash(git commit *--no-verify*)",
            "Bash(git commit -n*)",
            "Bash(git commit * -n*)",
            "Bash(git push *--no-verify*)",
            "Bash(git push *--force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push * +*)",
            "Bash(sudo *)",
            "Bash(terraform apply *)",
            "Bash(kubectl apply *)",
            "Bash(helm upgrade *)"
          ]
        }
      }
    },
    "bypass-off": {
      "type": "settings",
      "title": "Bypass permissions mode disabled in the projects you apply",
      "description": "Claude Code then refuses bypassPermissions mode and rejects --dangerously-skip-permissions in each project you apply the profile to, so every session there keeps its prompts. The switch is this machine's: once on, it goes into every project applied afterwards, Orca's included, and Orca starts its Claude Code workers with that flag, so they cannot run there; it is off by default (https://code.claude.com/docs/en/settings-reference#permissions-disablebypasspermissionsmode). Switched off after an apply, the setting stays: remove permissions.disableBypassPermissionsMode from the project's .claude/settings.local.json by hand, as undo of the run stops working once Claude Code itself writes that file.",
      "default": "off",
      "commit": false,
      "set": {
        "permissions": {
          "disableBypassPermissionsMode": "disable"
        }
      }
    },
    "tier": {
      "type": "tier",
      "title": "Default tier: the agent picks per request",
      "default": "on",
      "tier": null
    }
  }
}
